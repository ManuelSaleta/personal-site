    "firebase": "^12.19.0",
    "pinia": "^3.0.4",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-router": "^0.19.2",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass-embedded": "^1.104.0",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^7.3.6",
